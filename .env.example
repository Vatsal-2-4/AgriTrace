# Live mandi price and arrival data (CEDA Agmarknet)
CEDA_API_TOKEN=your_ceda_api_token

# MongoDB Atlas connection string (server-only; never prefix with VITE_)
MONGO_URI=mongodb+srv://<database_user>:<url_encoded_password>@<cluster-host>/agritrace?retryWrites=true&w=majority&appName=AgriTrace

# Server-side marketplace access-token signing key (use a long random value)
JWT_SECRET=replace_with_a_long_random_secret


# Optional: configure a public app URL for payment callbacks
VITE_APP_URL=http://localhost:5174

# Direct UPI intent/QR configuration. The VITE values power the local frontend
# fallback; UPI_COLLECT_VPA is used by the optional serverless API.
VITE_UPI_ID=your-project-vpa@bank
VITE_UPI_NAME=AgriTrace Trade Payment
PAYMENT_GATEWAY_PROVIDER=DIRECT_UPI
UPI_COLLECT_VPA=khetsetu@upi

# Production gateway credentials belong only in the deployment environment.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Telegram notifications (server-only; never prefix the token with VITE_)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_chat_id_for_simple_demo_mode
TELEGRAM_BOT_USERNAME=KhetSetuBot
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
APP_BASE_URL=https://your-project.vercel.app

# Local inference bridge; install requirements.txt in this Python environment
PYTHON_EXECUTABLE=python

# LightGBM review and market advisory (Qwen 3.8 27B on Groq)
GROQ_API_KEY=your_groq_api_key

# Separate CPU service for YOLO on deployed instances; local dev uses Python CLI
QUALITY_INFERENCE_URL=
QUALITY_SERVICE_TOKEN=
QUALITY_PORT=8091
